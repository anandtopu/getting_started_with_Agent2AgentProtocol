[
  {
    "module": "00",
    "title": "Select the loopback vendor URL",
    "solution": "return f\"http://127.0.0.1:{payload['port']}\"",
    "broken": "return f\"http://0.0.0.0:{payload['port']}\"",
    "cases": [
      {
        "input": {
          "port": 8100
        },
        "expected": "http://127.0.0.1:8100"
      },
      {
        "input": {
          "port": 8102
        },
        "expected": "http://127.0.0.1:8102"
      }
    ],
    "feedback": "Bind local teaching services to the loopback interface."
  },
  {
    "module": "01",
    "title": "Construct a SendMessage envelope",
    "solution": "return {'jsonrpc': '2.0', 'id': payload['id'], 'method': 'SendMessage', 'params': {'message': payload['message']}}",
    "broken": "return {'jsonrpc': '2.0', 'id': payload['id'], 'method': 'SendMessage', 'params': payload['message']}",
    "cases": [
      {
        "input": {
          "id": 1,
          "message": {
            "messageId": "m1",
            "role": "ROLE_USER",
            "parts": [
              {
                "text": "Quote a venue"
              }
            ]
          }
        },
        "expected": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "SendMessage",
          "params": {
            "message": {
              "messageId": "m1",
              "role": "ROLE_USER",
              "parts": [
                {
                  "text": "Quote a venue"
                }
              ]
            }
          }
        }
      },
      {
        "input": {
          "id": "m2",
          "message": {
            "messageId": "m2",
            "role": "ROLE_USER",
            "parts": [
              {
                "text": "Hold a date"
              }
            ]
          }
        },
        "expected": {
          "jsonrpc": "2.0",
          "id": "m2",
          "method": "SendMessage",
          "params": {
            "message": {
              "messageId": "m2",
              "role": "ROLE_USER",
              "parts": [
                {
                  "text": "Hold a date"
                }
              ]
            }
          }
        }
      }
    ],
    "feedback": "The method parameters contain a message object, not its individual fields."
  },
  {
    "module": "02",
    "title": "Select a compatible advertised interface",
    "solution": "return next((i['url'] for i in payload['interfaces'] if i['protocolBinding'] in payload['supported'] and i['protocolVersion'] == '1.0'), None)",
    "broken": "return payload['interfaces'][0]['url']",
    "cases": [
      {
        "input": {
          "interfaces": [
            {
              "url": "http://print",
              "protocolBinding": "GRPC",
              "protocolVersion": "1.0"
            },
            {
              "url": "http://venues",
              "protocolBinding": "JSONRPC",
              "protocolVersion": "1.0"
            }
          ],
          "supported": [
            "JSONRPC"
          ]
        },
        "expected": "http://venues"
      },
      {
        "input": {
          "interfaces": [
            {
              "url": "http://old",
              "protocolBinding": "JSONRPC",
              "protocolVersion": "0.3"
            }
          ],
          "supported": [
            "JSONRPC"
          ]
        },
        "expected": null
      }
    ],
    "feedback": "Respect both protocol version and binding, preserving advertised preference."
  },
  {
    "module": "03",
    "title": "Order a task lifecycle stream",
    "solution": "return ['task', 'working'] + payload['artifacts'] + ['completed']",
    "broken": "return ['working'] + payload['artifacts'] + ['task']",
    "cases": [
      {
        "input": {
          "artifacts": [
            "quote"
          ]
        },
        "expected": [
          "task",
          "working",
          "quote",
          "completed"
        ]
      },
      {
        "input": {
          "artifacts": []
        },
        "expected": [
          "task",
          "working",
          "completed"
        ]
      }
    ],
    "feedback": "Introduce the task before updates and explicitly reach a final state."
  },
  {
    "module": "04",
    "title": "Classify a response payload",
    "solution": "return 'task' if 'task' in payload else 'message' if 'message' in payload else 'error'",
    "broken": "return 'task'",
    "cases": [
      {
        "input": {
          "task": {
            "id": "t1"
          }
        },
        "expected": "task"
      },
      {
        "input": {
          "message": {
            "messageId": "m1"
          }
        },
        "expected": "message"
      },
      {
        "input": {
          "error": {
            "code": -32001
          }
        },
        "expected": "error"
      }
    ],
    "feedback": "Inspect the response wrapper instead of assuming every reply creates a task."
  },
  {
    "module": "05",
    "title": "Distinguish terminal from interrupted states",
    "solution": "return payload['state'] in {'TASK_STATE_COMPLETED', 'TASK_STATE_FAILED', 'TASK_STATE_CANCELED', 'TASK_STATE_REJECTED'}",
    "broken": "return payload['state'] != 'TASK_STATE_WORKING'",
    "cases": [
      {
        "input": {
          "state": "TASK_STATE_COMPLETED"
        },
        "expected": true
      },
      {
        "input": {
          "state": "TASK_STATE_FAILED"
        },
        "expected": true
      },
      {
        "input": {
          "state": "TASK_STATE_CANCELED"
        },
        "expected": true
      },
      {
        "input": {
          "state": "TASK_STATE_REJECTED"
        },
        "expected": true
      },
      {
        "input": {
          "state": "TASK_STATE_INPUT_REQUIRED"
        },
        "expected": false
      },
      {
        "input": {
          "state": "TASK_STATE_AUTH_REQUIRED"
        },
        "expected": false
      },
      {
        "input": {
          "state": "TASK_STATE_SUBMITTED"
        },
        "expected": false
      },
      {
        "input": {
          "state": "TASK_STATE_WORKING"
        },
        "expected": false
      },
      {
        "input": {
          "state": "TASK_STATE_UNSPECIFIED"
        },
        "expected": false
      }
    ],
    "feedback": "Input-required and auth-required are resumable; terminal states are not."
  },
  {
    "module": "06",
    "title": "Preserve binary files using ProtoJSON",
    "solution": "import base64\nreturn {'raw': base64.b64encode(payload['text'].encode()).decode(), 'mediaType': payload['media_type'], 'filename': payload['filename']}",
    "broken": "return {'raw': payload['text'], 'mediaType': payload['media_type']}",
    "cases": [
      {
        "input": {
          "text": "floor plan",
          "media_type": "text/plain",
          "filename": "plan.txt"
        },
        "expected": {
          "raw": "Zmxvb3IgcGxhbg==",
          "mediaType": "text/plain",
          "filename": "plan.txt"
        }
      },
      {
        "input": {
          "text": "abc",
          "media_type": "application/octet-stream",
          "filename": "art.bin"
        },
        "expected": {
          "raw": "YWJj",
          "mediaType": "application/octet-stream",
          "filename": "art.bin"
        }
      }
    ],
    "feedback": "Binary content becomes base64 in JSON; keep the media type and filename."
  },
  {
    "module": "07",
    "title": "Assemble artifact chunks by artifact ID",
    "solution": "result = {}\nfor chunk in payload:\n    key = chunk['id']\n    if chunk.get('append') and key not in result:\n        return {'error': 'unknown artifact'}\n    result[key] = result.get(key, '') + chunk['text'] if chunk.get('append') else chunk['text']\nreturn result",
    "broken": "return {chunk['id']: chunk['text'] for chunk in payload}",
    "cases": [
      {
        "input": [
          {
            "id": "a",
            "text": "Mic "
          },
          {
            "id": "b",
            "text": "Light"
          },
          {
            "id": "a",
            "text": "check",
            "append": true
          }
        ],
        "expected": {
          "a": "Mic check",
          "b": "Light"
        }
      },
      {
        "input": [
          {
            "id": "a",
            "text": "orphan",
            "append": true
          }
        ],
        "expected": {
          "error": "unknown artifact"
        }
      }
    ],
    "feedback": "Append only to an existing artifact with the same ID."
  },
  {
    "module": "08",
    "title": "Map core operations to HTTP routes",
    "solution": "routes = {'SendMessage': ('POST', '/message:send'), 'GetTask': ('GET', '/tasks/' + payload.get('id', '')), 'CancelTask': ('POST', '/tasks/' + payload.get('id', '') + ':cancel')}\nreturn list(routes[payload['operation']])",
    "broken": "return ['POST', '/message:send']",
    "cases": [
      {
        "input": {
          "operation": "SendMessage"
        },
        "expected": [
          "POST",
          "/message:send"
        ]
      },
      {
        "input": {
          "operation": "GetTask",
          "id": "quote-2"
        },
        "expected": [
          "GET",
          "/tasks/quote-2"
        ]
      },
      {
        "input": {
          "operation": "CancelTask",
          "id": "quote-3"
        },
        "expected": [
          "POST",
          "/tasks/quote-3:cancel"
        ]
      }
    ],
    "feedback": "HTTP routes differ from JSON-RPC method strings; protobuf annotations define the mapping."
  },
  {
    "module": "09",
    "title": "Validate model-selected tool names",
    "solution": "return payload['tool'] if payload['tool'] in {'ask_dietary', 'quote_menu'} else 'reject'",
    "broken": "return payload['tool']",
    "cases": [
      {
        "input": {
          "tool": "quote_menu"
        },
        "expected": "quote_menu"
      },
      {
        "input": {
          "tool": "ask_dietary"
        },
        "expected": "ask_dietary"
      },
      {
        "input": {
          "tool": "send_credentials"
        },
        "expected": "reject"
      }
    ],
    "feedback": "A model suggests tools; application code owns the allow-list."
  },
  {
    "module": "10",
    "title": "Minimize delegated event data",
    "solution": "return {key: payload[key] for key in ('guests', 'date', 'dietary', 'rooms') if key in payload}",
    "broken": "return payload",
    "cases": [
      {
        "input": {
          "guests": 40,
          "date": "2027-06-01",
          "authorization": "secret"
        },
        "expected": {
          "guests": 40,
          "date": "2027-06-01"
        }
      },
      {
        "input": {
          "rooms": 10,
          "private_notes": "sensitive",
          "user_email": "fictional@example.invalid"
        },
        "expected": {
          "rooms": 10
        }
      }
    ],
    "feedback": "Pass only the business fields required by the selected vendor."
  },
  {
    "module": "11",
    "title": "Normalize framework output at the A2A boundary",
    "solution": "return {'vendor': payload['vendor'], 'total_cents': int(payload['amount']), 'currency': 'USD', 'approved': False}",
    "broken": "return {'vendor': payload['vendor'], 'total_cents': payload['amount'], 'approved': True}",
    "cases": [
      {
        "input": {
          "vendor": "catering",
          "amount": "96000"
        },
        "expected": {
          "vendor": "catering",
          "total_cents": 96000,
          "currency": "USD",
          "approved": false
        }
      },
      {
        "input": {
          "vendor": "print",
          "amount": "10000"
        },
        "expected": {
          "vendor": "print",
          "total_cents": 10000,
          "currency": "USD",
          "approved": false
        }
      }
    ],
    "feedback": "Map validated framework results into a stable quote contract; never infer spending approval."
  },
  {
    "module": "12",
    "title": "Choose inventory tools versus remote work",
    "solution": "return 'MCP' if payload['operation'] == 'inventory_lookup' else 'A2A'",
    "broken": "return 'A2A'",
    "cases": [
      {
        "input": {
          "operation": "inventory_lookup"
        },
        "expected": "MCP"
      },
      {
        "input": {
          "operation": "vendor_quote"
        },
        "expected": "A2A"
      },
      {
        "input": {
          "operation": "hotel_task"
        },
        "expected": "A2A"
      }
    ],
    "feedback": "Internal inventory lookup is a tool; independently owned work remains an agent task."
  },
  {
    "module": "13",
    "title": "Authorize the requested partner skill",
    "solution": "return payload['authenticated'] and (payload['skill'] != 'travel.partner_quote' or 'partner' in payload['scopes'])",
    "broken": "return payload['authenticated']",
    "cases": [
      {
        "input": {
          "authenticated": true,
          "skill": "travel.partner_quote",
          "scopes": []
        },
        "expected": false
      },
      {
        "input": {
          "authenticated": true,
          "skill": "travel.partner_quote",
          "scopes": [
            "partner"
          ]
        },
        "expected": true
      },
      {
        "input": {
          "authenticated": false,
          "skill": "travel.quote",
          "scopes": [
            "partner"
          ]
        },
        "expected": false
      }
