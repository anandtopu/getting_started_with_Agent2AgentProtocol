  {
    "module": "20",
    "title": "Compensate only confirmed holds",
    "solution": "return ['release:' + hold['id'] for hold in reversed(payload['holds']) if hold['confirmed']] if payload['failed'] else []",
    "broken": "return ['release:' + hold['id'] for hold in payload['holds']]",
