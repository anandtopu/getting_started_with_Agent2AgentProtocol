    "feedback": "Authentication alone does not grant partner pricing."
  },
  {
    "module": "14",
    "title": "Keep task owners isolated",
    "solution": "return payload['task']['owner'] == payload['principal']['subject'] and payload['task']['tenant'] == payload['principal']['tenant']",
    "broken": "return payload['task']['tenant'] == payload['principal']['tenant']",
    "cases": [
      {
        "input": {
          "task": {
            "owner": "alice",
            "tenant": "maplewood"
          },
          "principal": {
            "subject": "bob",
            "tenant": "maplewood"
          }
        },
        "expected": false
      },
      {
        "input": {
          "task": {
            "owner": "alice",
            "tenant": "maplewood"
          },
          "principal": {
            "subject": "alice",
            "tenant": "maplewood"
          }
        },
        "expected": true
      },
      {
        "input": {
          "task": {
            "owner": "alice",
            "tenant": "other"
          },
          "principal": {
            "subject": "alice",
            "tenant": "maplewood"
          }
        },
        "expected": false
      }
    ],
    "feedback": "A matching tenant is not permission to read another caller's task."
  },
  {
    "module": "15",
    "title": "Reject private and reserved IP addresses",
    "solution": "import ipaddress\ntry:\n    return ipaddress.ip_address(payload['address']).is_global\nexcept ValueError:\n    return False",
    "broken": "return not payload['address'].startswith('127.')",
    "cases": [
      {
        "input": {
          "address": "127.0.0.1"
        },
        "expected": false
      },
      {
        "input": {
          "address": "10.1.2.3"
        },
        "expected": false
      },
      {
        "input": {
          "address": "169.254.169.254"
        },
        "expected": false
      },
      {
        "input": {
          "address": "::1"
        },
        "expected": false
      },
      {
        "input": {
          "address": "8.8.8.8"
        },
        "expected": true
      },
      {
        "input": {
          "address": "attacker.example"
        },
        "expected": false
      }
    ],
    "feedback": "This IP check is one layer; production fetches also need allow-lists, no redirects and DNS rebinding protection."
  },
  {
    "module": "16",
    "title": "Detect invalid mixed event streams",
    "solution": "if not payload:\n    return False\nif payload[0] == 'message':\n    return len(payload) == 1\nreturn payload[0] == 'task' and 'message' not in payload and payload[-1] in {'completed', 'failed', 'canceled', 'rejected', 'input-required', 'auth-required'}",
    "broken": "return bool(payload)",
    "cases": [
      {
        "input": [
          "message"
        ],
        "expected": true
      },
      {
        "input": [
          "message",
          "task"
        ],
        "expected": false
      },
      {
        "input": [
          "working",
          "completed"
        ],
        "expected": false
      },
      {
        "input": [
          "task",
          "working",
          "completed"
        ],
        "expected": true
      },
      {
        "input": [
          "task",
          "working"
        ],
        "expected": false
      }
    ],
    "feedback": "A direct message is a complete response; a task stream needs a valid introduction and stop condition."
  },
  {
    "module": "17",
    "title": "Evaluate golden delegations without prose scoring",
    "solution": "return sorted(payload['actual']) == sorted(payload['expected']) and len(payload['actual']) == len(set(payload['actual']))",
    "broken": "return len(payload['actual']) == len(payload['expected'])",
    "cases": [
      {
        "input": {
          "actual": [
            "venues",
            "catering"
          ],
          "expected": [
            "catering",
            "venues"
          ]
        },
        "expected": true
      },
      {
        "input": {
          "actual": [
            "venues",
            "venues"
          ],
          "expected": [
            "venues",
            "catering"
          ]
        },
        "expected": false
      },
      {
        "input": {
          "actual": [
            "venues"
          ],
          "expected": [
            "venues",
            "av"
          ]
        },
        "expected": false
      }
    ],
    "feedback": "Match identity and cardinality; equal list lengths do not prove correct delegation."
  },
  {
    "module": "18",
    "title": "Check required extension activation",
    "solution": "return all(not extension['required'] or extension['uri'] in payload['requested'] for extension in payload['extensions'])",
    "broken": "return True",
