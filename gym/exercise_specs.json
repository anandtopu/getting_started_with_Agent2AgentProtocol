  {
    "module": "19",
    "title": "Bound webhook retry attempts",
    "solution": "return min(payload['base_seconds'] * 2 ** payload['attempt'], payload['cap_seconds']) if payload['attempt'] < payload['max_attempts'] else None",
    "broken": "return payload['base_seconds'] * 2 ** payload['attempt']",
    "cases": [
      {
        "input": {
          "base_seconds": 1,
          "attempt": 2,
          "cap_seconds": 3,
          "max_attempts": 5
        },
        "expected": 3
      },
      {
        "input": {
          "base_seconds": 1,
          "attempt": 5,
          "cap_seconds": 30,
          "max_attempts": 5
        },
        "expected": null
      },
      {
        "input": {
          "base_seconds": 2,
          "attempt": 0,
          "cap_seconds": 30,
          "max_attempts": 5
        },
        "expected": 2
      }
